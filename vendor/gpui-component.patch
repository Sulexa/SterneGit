+    /// Replaces the files like [`Self::set_files`], but keeps the viewport:
+    /// the source line at its top stays there while the new files still show
+    /// it, and the same row stays at the top otherwise.
+    pub fn refresh_files(
+        &mut self,
+        files: impl IntoIterator<Item = DiffFile>,
+        cx: &mut Context<Self>,
+    ) {
+        let top = self.list.logical_scroll_top();
+        let anchor = self.row_position(top.item_ix);
+        self.set_files(files, cx);
+        let anchored = anchor.and_then(|anchor| self.source_row(&anchor));
+        let item_ix = anchored.unwrap_or(top.item_ix.min(self.rows.len().saturating_sub(1)));
+        self.list.scroll_to(ListOffset {
+            item_ix,
+            offset_in_item: top.offset_in_item,
+        });
+        cx.notify();
+    }
+
